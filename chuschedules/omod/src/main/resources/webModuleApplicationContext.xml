<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">

    <!--
        Registers this module's pages, fragments and resources with the UI framework.
        Without it, every .page under chuschedules/ fails with "No viewProvider named
        chuschedules": the controllers load, but nothing can render them.
    -->
    <bean class="org.openmrs.ui.framework.StandardModuleUiConfiguration">
        <property name="moduleId" value="chuschedules"/>
    </bean>

</beans>
