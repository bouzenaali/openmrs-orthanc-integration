<?xml version="1.0" encoding="UTF-8"?>

<module configVersion="1.2">
	
	<!-- Base Module Properties -->
	<id>${project.parent.artifactId}</id>
	<name>${project.parent.name}</name>
	<version>${project.parent.version}</version>
	<package>org.openmrs.module.imaging</package>
	<author>UCLouvain-ICTEAM</author>
	<description>
			${project.parent.description}
	</description>

	<activator>org.openmrs.module.imaging.ImagingActivator</activator>
	
	<!-- <updateURL>https://modules.openmrs.org/modules/download/@MODULE_ID@/update.rdf</updateURL> -->
	<!-- /Base Module Properties -->
	
	<require_version>${openmrsPlatformVersion}</require_version>

	<require_modules>
		<require_module version="${appframeworkVersion}">
			org.openmrs.module.appframework
		</require_module>
		<require_module version="${uiframeworkVersion}">
			org.openmrs.module.uiframework
		</require_module>
		<require_module version="${uicommonsModuleVersion}">
			org.openmrs.module.uicommons
		</require_module>
		<require_module version="${appuiVersion}">
			org.openmrs.module.appui
		</require_module>
		<require_module version="${webservicesRestModuleVersion}">
			org.openmrs.module.webservices.rest
		</require_module>
	</require_modules>
	
	<!-- Extensions -->
	<extension>
		<point>org.openmrs.admin.list</point>
		<class>org.openmrs.module.imaging.extension.html.AdminList</class>
	</extension>

	<aware_of_modules>
		<aware_of_module>org.openmrs.module.legacyui</aware_of_module>
	</aware_of_modules>

	<mappingFiles>
		OrthancConfiguration.hbm.xml
		DicomStudy.hbm.xml
		RequestProcedure.hbm.xml
		RequestProcedureStep.hbm.xml
	</mappingFiles>

	<privilege>
		<name>Task: Manager Orthanc Configuration</name>
		<description>Able to add, delete configuration</description>
	</privilege>

	<privilege>
		<name>Task: Modify Image Data</name>
		<description>Able to add, delete image data</description>
	</privilege>

	<privilege>
		<name>Task: Edit Worklist</name>
		<description>Able to add, delete worklist</description>
	</privilege>

	<privilege>
		<name>Task: Use AI Imaging Viewer</name>
		<description>Able to open studies in the AI imaging viewer (OHIF-AI), whose segmentations are written back to the PACS as clinical data</description>
	</privilege>

	<!-- Required Global Properties -->
	<globalProperty>
		<property>imaging.maxUploadImageDataSize</property>
		<defaultValue>200000000</defaultValue>
		<description>Set maximum size for upload of image study data</description>
	</globalProperty>

	<globalProperty>
		<property>imaging.ohifBaseUrl</property>
		<defaultValue></defaultValue>
		<description>
			Base URL of the OHIF viewer deployment (e.g. https://viewer.hospital.lan),
			with no trailing slash. Used to build the "open in OHIF" links on the
			studies and series pages - separate from the Orthanc server URLs below
			since OHIF is deployed as its own service, not a subpath of Orthanc.
		</description>
	</globalProperty>

	<globalProperty>
		<property>imaging.ohifAiBaseUrl</property>
		<defaultValue></defaultValue>
		<description>
			Base URL of the OHIF-AI viewer (e.g. https://ai-viewer.hospital.lan), with no
			trailing slash. Empty by default, which hides the AI button entirely - the
			routine OHIF viewer is unaffected either way. Users also need the
			"Task: Use AI Imaging Viewer" privilege before the button is shown.
			Set this through the OpenMRS UI, never by SQL: global properties are cached
			in memory and a direct UPDATE leaves the running instance on the old value.
		</description>
	</globalProperty>

	<globalProperty>
		<property>imaging.matchThreshold.veryHigh</property>
		<defaultValue>95</defaultValue>
		<description>
			Lower bound (0-100, inclusive) of the "Very High" patient-match confidence
			band shown on the "Get studies" and worklist matching screens. Must be
			greater than imaging.matchThreshold.high. If this or any of the other 3
			match-threshold properties is missing, non-numeric, or the 4 values are not
			strictly decreasing, all 4 fall back to their defaults (95/75/50/25).
		</description>
	</globalProperty>

	<globalProperty>
		<property>imaging.matchThreshold.high</property>
		<defaultValue>75</defaultValue>
		<description>
			Lower bound (0-100, inclusive) of the "High" patient-match confidence band.
			Must be greater than imaging.matchThreshold.medium and less than
			imaging.matchThreshold.veryHigh.
		</description>
	</globalProperty>

	<globalProperty>
		<property>imaging.matchThreshold.medium</property>
		<defaultValue>50</defaultValue>
		<description>
			Lower bound (0-100, inclusive) of the "Medium" patient-match confidence
			band. Must be greater than imaging.matchThreshold.low and less than
			imaging.matchThreshold.high.
		</description>
	</globalProperty>

	<globalProperty>
		<property>imaging.matchThreshold.low</property>
		<defaultValue>25</defaultValue>
		<description>
			Lower bound (0-100, inclusive) of the "Low" patient-match confidence band.
			Scores below this value are shown as "Very Low". Must be less than
			imaging.matchThreshold.medium.
		</description>
	</globalProperty>

