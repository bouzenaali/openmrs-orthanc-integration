@charset "UTF-8";
/*!
 * CHU Blida Clinical Theme for OpenMRS Reference Application 2.12.2
 * Centre Hospitalo-Universitaire de Blida
 *
 * Layered over the stock uicommons / referenceapplication / legacyui stylesheets.
 * No upstream file is modified. Stopping the chublidatheme module removes all of this.
 *
 * Conventions used throughout:
 *   - CSS logical properties only (inline-start/end), so Arabic RTL works without a second sheet.
 *   - Only transform and opacity are animated, so nothing forces layout during interaction.
 *   - Clinical status is never colour alone; every status rule pairs colour with an icon or weight.
 *   - Custom DOM added by chu-theme.js is namespaced `chu-`.
 */

/* === GENERATED TOKENS — do not edit by hand; run tools/build-tokens.mjs === */
:root {
  /* primitives */
  --chu-teal-50: #F3F9F7;
  --chu-teal-100: #E5F3EF;
  --chu-teal-200: #C8ECE1;
  --chu-teal-300: #98E9D1;
  --chu-teal-400: #68DFBB;
  --chu-teal-500: #29C093;
  --chu-teal-600: #26B389;
  --chu-teal-700: #218C6C;
  --chu-teal-800: #1A6C53;
  --chu-teal-900: #13513E;
  --chu-teal-950: #0D3629;
  --chu-blue-50: #F1F5FB;
  --chu-blue-100: #E1E9F6;
  --chu-blue-200: #BED2F6;
  --chu-blue-300: #82AFFF;
  --chu-blue-400: #478AFF;
  --chu-blue-500: #0A63FF;
  --chu-blue-600: #004ED9;
  --chu-blue-700: #0440A9;
  --chu-blue-800: #033182;
  --chu-blue-900: #022561;
  --chu-blue-950: #021841;
  --chu-amber-50: #FBF8F1;
  --chu-amber-100: #F6F0E2;
  --chu-amber-200: #F5E4BF;
  --chu-amber-300: #FDD784;
  --chu-amber-400: #FBC44B;
  --chu-amber-500: #FAB00F;
  --chu-amber-600: #D59304;
  --chu-amber-700: #A67408;
  --chu-amber-800: #805906;
  --chu-amber-900: #604304;
  --chu-red-50: #FDECEA;
  --chu-red-100: #FBD9D5;
  --chu-red-200: #F5B0A9;
  --chu-red-500: #DA3B31;
  --chu-red-600: #B3261E;
  --chu-red-700: #8C1D17;
  --chu-red-800: #6B1611;
  --chu-neutral-0: #FFFFFF;
  --chu-neutral-25: #FBFCFC;
  --chu-neutral-50: #F6F8F7;
  --chu-neutral-100: #EEF2F0;
  --chu-neutral-200: #DCE5E1;
  --chu-neutral-300: #C4D2CC;
  --chu-neutral-400: #7C8F88;
  --chu-neutral-500: #657570;
  --chu-neutral-600: #4A5B55;
  --chu-neutral-700: #33433D;
  --chu-neutral-800: #1E2E28;
  --chu-neutral-900: #12211C;
  --chu-neutral-950: #0A1512;

  /* semantic */
  --chu-canvas: #F6F8F7;  /* app background */
  --chu-surface: #FFFFFF;  /* cards, header, tables */
  --chu-surface-sunken: #F3F9F7;
  --chu-surface-raised: #FFFFFF;
  --chu-surface-brand: #0D3629;  /* inverted areas */
  --chu-ink: #12211C;
  --chu-ink-muted: #4A5B55;
  --chu-ink-subtle: #657570;
  --chu-ink-inverse: #FFFFFF;
  --chu-action: #1A6C53;  /* primary buttons; white text 6.34:1 */
  --chu-action-hover: #13513E;
  --chu-action-soft: #E5F3EF;
  --chu-action-quiet: #218C6C;  /* icons and borders; >=3:1 */
  --chu-link: #004ED9;
  --chu-link-hover: #0440A9;
  --chu-focus: #0A63FF;
  --chu-brand-vivid: #29C093;  /* DECORATIVE ONLY - 2.32:1, never text or a meaningful edge */
  --chu-brand-blue: #0057F1;  /* DECORATIVE ONLY */
  --chu-border: #DCE5E1;  /* decorative dividers */
  --chu-border-strong: #C4D2CC;
  --chu-border-control: #7C8F88;  /* meaningful control outlines; >=3:1 */
  --chu-critical: #B3261E;
  --chu-critical-bg: #FDECEA;
  --chu-warning: #805906;
  --chu-warning-bg: #F6F0E2;
  --chu-success: #1A6C53;
  --chu-success-bg: #E5F3EF;
  --chu-info: #0440A9;
  --chu-info-bg: #E1E9F6;

  /* spacing */
  --chu-space-1: 4px;
  --chu-space-2: 8px;
  --chu-space-3: 12px;
  --chu-space-4: 16px;
  --chu-space-5: 24px;
  --chu-space-6: 32px;
  --chu-space-7: 48px;
  --chu-space-8: 64px;

  /* radii */
  --chu-radius-sm: 4px;
  --chu-radius-md: 8px;
  --chu-radius-lg: 12px;
  --chu-radius-xl: 18px;
  --chu-radius-pill: 999px;

  /* elevation */
  --chu-shadow-1: 0 1px 2px rgba(18,33,28,.06), 0 1px 3px rgba(18,33,28,.08);
  --chu-shadow-2: 0 2px 6px rgba(18,33,28,.07), 0 6px 16px rgba(18,33,28,.09);
  --chu-shadow-3: 0 8px 24px rgba(18,33,28,.10), 0 16px 48px rgba(18,33,28,.12);
  --chu-shadow-rail: 0 0 0 1px rgba(18,33,28,.05), 8px 0 28px rgba(18,33,28,.10);

  /* type */
  --chu-font-ui: "Inter", "Segoe UI", system-ui, -apple-system, "Helvetica Neue", Arial, sans-serif;
  --chu-font-display: "Cairo", "Inter", "Segoe UI", system-ui, sans-serif;
  --chu-font-mono: "JetBrains Mono", "Cascadia Mono", Consolas, "Courier New", monospace;
  --chu-text-xs: 12px;
  --chu-text-sm: 13px;
  --chu-text-base: 14px;
  --chu-text-md: 15px;
  --chu-text-lg: 16px;
  --chu-text-xl: 20px;
  --chu-text-2xl: 24px;
  --chu-text-3xl: 28px;

  /* motion */
  --chu-dur-instant: 90ms;
  --chu-dur-fast: 140ms;
  --chu-dur-base: 220ms;
  --chu-dur-slow: 320ms;
  --chu-ease-out: cubic-bezier(.22,.8,.28,1);
  --chu-ease-in: cubic-bezier(.5,0,.75,0);
  --chu-ease-spring: cubic-bezier(.34,1.42,.64,1);

  /* layout */
  --chu-rail-collapsed: 56px;
  --chu-rail-expanded: 248px;
  --chu-panel-width: 380px;
  --chu-header-height: 58px;
  --chu-content-max: 1600px;
}
/* === END GENERATED TOKENS === */


/* ==========================================================================
   1. Self-hosted fonts
   A hospital intranet may have no route to fonts.googleapis.com, so both
   families ship inside the omod. font-display:swap keeps text readable while
   they load.
   ========================================================================== */

