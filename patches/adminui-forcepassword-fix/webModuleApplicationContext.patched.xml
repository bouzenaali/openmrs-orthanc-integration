<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:p="http://www.springframework.org/schema/p"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:jee="http://www.springframework.org/schema/jee"
       xmlns:tx="http://www.springframework.org/schema/tx"
       xmlns:aop="http://www.springframework.org/schema/aop"
       xmlns:util="http://www.springframework.org/schema/util"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
  		    http://www.springframework.org/schema/beans/spring-beans-3.0.xsd
  		    http://www.springframework.org/schema/context
  		    http://www.springframework.org/schema/context/spring-context-3.0.xsd
  		    http://www.springframework.org/schema/jee
  		    http://www.springframework.org/schema/jee/spring-jee-3.0.xsd
  		    http://www.springframework.org/schema/tx
  		    http://www.springframework.org/schema/tx/spring-tx-3.0.xsd
  		    http://www.springframework.org/schema/aop
  		    http://www.springframework.org/schema/aop/spring-aop-3.0.xsd
  		    http://www.springframework.org/schema/util
  		    http://www.springframework.org/schema/util/spring-util-3.0.xsd">

	<!-- Add here beans related to the web context -->

	<!-- UI Framework setup -->
	<bean class="org.openmrs.ui.framework.StandardModuleUiConfiguration">
		<property name="moduleId" value="adminui"/>
	</bean>

    <bean id="changePasswordPageController" class="org.openmrs.module.adminui.page.controller.myaccount.ChangePasswordPageController" />

    <!--
        PATCHED (local fix): the SimpleUrlHandlerMapping below was removed.

        It mapped the legacy URL /admin/users/changePassword.form to
        ChangePasswordPageController, which is a UI Framework *page* controller.
        Spring MVC's DispatcherServlet has no HandlerAdapter capable of invoking a
        page controller, so any dispatch to that URL failed with:

            javax.servlet.ServletException: No adapter for handler
            [org.openmrs.module.adminui.page.controller.myaccount.ChangePasswordPageController]

        This broke login for every user with the user property forcePassword=true,
        because legacyui's forcePasswordChangeFilter (registered by
        org.openmrs.web.WebComponentRegistrar with
        changePasswordForm=/admin/users/changePassword.form) forwards every request
        from such a user to that exact URL.

        With this mapping gone, the URL falls through to legacyui's annotated
        @Controller org.openmrs.web.controller.user.ChangePasswordFormController,
        which renders /module/legacyui/admin/users/changePasswordForm and is
        dispatched normally by RequestMappingHandlerAdapter.

        Original block, kept for reference:

        <bean id="adminiuiUrlMapping" class="org.springframework.web.servlet.handler.SimpleUrlHandlerMapping">
            <property name="order"><value>10</value></property>
            <property name="mappings">
                <props>
                    <prop key="/admin/users/changePassword.form">changePasswordPageController</prop>
                </props>
            </property>
        </bean>
    -->

</beans>
